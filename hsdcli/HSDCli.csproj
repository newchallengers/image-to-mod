<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <RootNamespace>modder.hsdcli</RootNamespace>
    <AssemblyName>hsdcli</AssemblyName>
    <NoWarn>CS0162;CS0168;CS0219;CS8632</NoWarn>
    <DefineConstants>NO_DEBUG_METAL</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="HSDRaw">
      <HintPath>../HSDLib/HSDRaw/bin/Release/netstandard2.0/HSDRaw.dll</HintPath>
    </Reference>
    <Reference Include="IONET">
      <HintPath>../HSDLib/HSDRawViewer/lib/IONET.dll</HintPath>
    </Reference>
    <PackageReference Include="OpenTK.Mathematics" Version="4.8.2" />
    <PackageReference Include="YamlDotNet" Version="15.1.6" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
  </ItemGroup>
</Project>
